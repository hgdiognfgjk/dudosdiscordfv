# ============================================================
# /KING
# ============================================================

@bot.tree.command(
    name="king",
    description="Создать игровые каналы 1-40"
)
@app_commands.checks.has_permissions(administrator=True)
async def king(interaction: discord.Interaction):

    if interaction.guild is None:

        await interaction.response.send_message(
            "❌ Команда работает только на сервере.",
            ephemeral=True
        )

        return

    await interaction.response.defer(
        ephemeral=True
    )

    guild = interaction.guild

    # --------------------------------------------------------
    # ИЩЕМ КАТЕГОРИЮ
    # --------------------------------------------------------

    category = discord.utils.get(
        guild.categories,
        name="🎮 ИГРА"
    )

    if category is None:

        try:

            category = await guild.create_category(
                name="🎮 ИГРА",
                reason="Создание категории командой /king"
            )

        except discord.Forbidden:

            await interaction.followup.send(
                "❌ У бота нет права «Управление каналами».",
                ephemeral=True
            )

            return

        except discord.HTTPException as error:

            await interaction.followup.send(
                f"❌ Ошибка Discord:\n`{error}`",
                ephemeral=True
            )

            return

    # --------------------------------------------------------
    # СОЗДАЁМ КАНАЛЫ
    # --------------------------------------------------------

    created = 0
    existing = 0

    for number in range(1, 41):

        channel_name = str(number)

        exists = any(
            isinstance(channel, discord.TextChannel)
            and channel.name == channel_name
            and channel.category_id == category.id
            for channel in guild.channels
        )

        if exists:

            existing += 1
            continue

        try:

            await guild.create_text_channel(
                name=channel_name,
                category=category,
                reason="Создание канала командой /king"
            )

            created += 1

            print(f"✅ Создан канал: {channel_name}")

        except discord.Forbidden:

            await interaction.followup.send(
                "❌ У бота нет права «Управление каналами».\n"
                f"Создано каналов: {created}",
                ephemeral=True
            )

            return

        except discord.HTTPException as error:

            print(
                f"❌ Ошибка создания канала "
                f"{channel_name}: {error}"
            )

    # --------------------------------------------------------
    # РЕЗУЛЬТАТ
    # --------------------------------------------------------

    await interaction.followup.send(

        f"✅ **ГОТОВО!**\n\n"
        f"🎮 Категория: **🎮 ИГРА**\n"
        f"➕ Создано: **{created}**\n"
        f"ℹ️ Уже было: **{existing}**\n"
        f"🔢 Всего: **40 каналов**",

        ephemeral=True
    )


# ============================================================
# ОШИБКИ /KING
# ============================================================

@king.error
async def king_error(
    interaction: discord.Interaction,
    error
):

    if isinstance(
        error,
        app_commands.MissingPermissions
    ):

        message = (
            "❌ Для `/king` нужны права администратора."
        )

        try:

            if interaction.response.is_done():

                await interaction.followup.send(
                    message,
                    ephemeral=True
                )

            else:

                await interaction.response.send_message(
                    message,
                    ephemeral=True
                )

        except Exception:
            pass

        return

    print(f"❌ Ошибка /king: {error}")

    try:

        if interaction.response.is_done():

            await interaction.followup.send(
                "❌ Произошла ошибка при выполнении команды.",
                ephemeral=True
            )

        else:

            await interaction.response.send_message(
                "❌ Произошла ошибка при выполнении команды.",
                ephemeral=True
            )

    except Exception:
        pass


# ============================================================
# ЗАПУСК ДЛЯ СРЕДЫ С УЖЕ ЗАПУЩЕННЫМ ASYNCIO
# ============================================================

async def start_bot():

    try:

        await bot.start(TOKEN)

    except discord.LoginFailure:

        print("❌ Неверный токен Discord-бота.")

    except Exception as error:

        print(f"❌ Ошибка запуска: {error}")


# Запускаем бота как задачу,
# НЕ используя asyncio.run() и bot.run()

asyncio.create_task(start_bot())
